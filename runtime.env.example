# Install as runtime.env on the server with mode 0600. Never commit real values.
GIAN_REMOTE_PUBLIC_ORIGIN=https://remote.example.com
GIAN_REMOTE_ALLOWED_ORIGINS=https://remote.example.com
GIAN_REMOTE_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_ADMIN_TOKEN
# GitHub OAuth App with Device Flow enabled (public client ID, not a secret).
GIAN_REMOTE_GITHUB_CLIENT_ID=
# Numeric account IDs, comma-separated. Empty disables new Host registration.
# Obtain your own ID with authenticated `gh api user --jq .id`.
GIAN_REMOTE_ENROLLMENT_GITHUB_IDS=
# Set only behind one loopback reverse proxy that sets or appends X-Forwarded-For.
# Rate limits then key on its last entry, the client address the proxy saw;
# unset, they key on the socket peer address.
GIAN_REMOTE_TRUSTED_PROXY=1
